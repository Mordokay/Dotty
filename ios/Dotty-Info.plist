<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keeps the Bluetooth link to Dotty alive in the background (state restoration, and later
	     iPhone notifications on Dotty). Merged with the build's generated Info.plist. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>
	<!-- Directions: location keeps coming with the iPhone in a pocket, started when Dotty asks. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Dotty guides you with directions while your iPhone is in your pocket.</string>
	<!-- Voice notes recorded on Dotty become text on this iPhone (Apple's on-device recognition). -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Dotty turns your voice notes into text on this iPhone.</string>
	<!-- Songs go to Dotty over the home Wi-Fi (plain HTTP to its local address). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Backups of Dotty's SD card (Documents/Backups) show up in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
